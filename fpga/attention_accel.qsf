# Generated by fpga/gen_qsf.py -- edit that, not this file.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY fullchip
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# RTL, from rtl/filelist.txt. All plain Verilog-2005: the packed
# multi-dimensional array that previously forced SystemVerilog in
# sfp_row.v has been removed.
set_global_assignment -name VERILOG_FILE ../rtl/sync.v
set_global_assignment -name VERILOG_FILE ../rtl/sync_mb.v
set_global_assignment -name VERILOG_FILE ../rtl/fifo_mux_2_1.v
set_global_assignment -name VERILOG_FILE ../rtl/fifo_mux_8_1.v
set_global_assignment -name VERILOG_FILE ../rtl/fifo_mux_16_1.v
set_global_assignment -name VERILOG_FILE ../rtl/fifo_depth16.v
set_global_assignment -name VERILOG_FILE ../rtl/ofifo.v
set_global_assignment -name VERILOG_FILE ../rtl/sram_w16.v
set_global_assignment -name VERILOG_FILE ../rtl/async_gray_fifo.v
set_global_assignment -name VERILOG_FILE ../rtl/seq_div.v
set_global_assignment -name VERILOG_FILE ../rtl/mac_8in.v
set_global_assignment -name VERILOG_FILE ../rtl/mac_col.v
set_global_assignment -name VERILOG_FILE ../rtl/mac_array.v
set_global_assignment -name VERILOG_FILE ../rtl/sfp_row.v
set_global_assignment -name VERILOG_FILE ../rtl/core.v
set_global_assignment -name VERILOG_FILE ../rtl/fullchip.v

set_global_assignment -name SDC_FILE attention_accel.sdc

# --- Power analysis ------------------------------------------------------
# Read per-node toggle rates from a simulation VCD. Without this the
# analyser uses vectorless estimation at a flat default toggle rate and
# cannot observe any data-dependent saving.
set_global_assignment -name POWER_USE_INPUT_FILE VCD
set_global_assignment -name POWER_INPUT_FILE_NAME ../sim/build/fullchip.vcd
set_global_assignment -name POWER_VCD_FILTER_GLITCHES ON
set_global_assignment -name POWER_REPORT_SIGNAL_ACTIVITY ON
set_global_assignment -name POWER_REPORT_POWER_DISSIPATION ON
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE "12.5 %"

# --- Synthesis -----------------------------------------------------------
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name AUTO_RESOURCE_SHARING ON
# Clock-enable inference is the FPGA equivalent of an integrated clock
# gating cell; mac_col.v expresses its gating as a register enable so
# that this can pick it up.
set_global_assignment -name AUTO_CLOCK_ENABLE_RECOGNITION ON
# Allow the 16-entry memories in sram_w16.v to map to M9K.
set_global_assignment -name AUTO_RAM_RECOGNITION ON

# --- Virtual pins (814) ------------------------------------------
# Only clk, clk2 and reset are real; the core's remaining ports exceed
# any package pin count.
set_instance_assignment -name VIRTUAL_PIN ON -to "mem_in_1[0]"
set_instance_assignment -name VIRTUAL_PIN ON -to "mem_in_1[1]"
